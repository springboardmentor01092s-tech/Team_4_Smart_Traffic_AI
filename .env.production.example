# =================================================================
# CityFlowX AI - Production Environment Variables Configuration
# =================================================================

# --- Backend Core Configuration ---
PROJECT_NAME="CityFlowX AI"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-random-64-character-hex-string-for-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database 1: Supabase PostgreSQL ---
# Found in your Supabase Project Settings -> Database -> Connection string
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-supabase-db-password"
POSTGRES_HOST="db.yourprojectref.supabase.co"
POSTGRES_PORT=5432
POSTGRES_DB="postgres"

# --- Database 2: MongoDB Atlas ---
# Found in MongoDB Atlas -> Database -> Connect -> Drivers
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=SmartTraffic"
MONGODB_DB_NAME="smarttraffic"

# --- External Traffic & Mapping APIs ---
GOOGLE_MAPS_API_KEY="your-google-maps-platform-api-key"
TOMTOM_API_KEY="your-tomtom-traffic-api-key"
HERE_API_KEY="your-here-traffic-api-key"

# --- Frontend Environment Variables (Client-Facing) ---
# Note: In production, point NEXT_PUBLIC_API_BASE_URL to your deployed backend URL (e.g. https://api.yourdomain.com/api/v1 or /api/v1 if behind reverse proxy)
NEXT_PUBLIC_API_BASE_URL="https://your-backend-domain.com/api/v1"
NEXT_PUBLIC_SUPABASE_URL="https://yourprojectref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-jwt-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-platform-api-key"
