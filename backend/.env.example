PROJECT_NAME="TrafficVision AI"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-jwt-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="trafficvision_db"

# MongoDB Atlas
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?appName=SmartTraffic"
MONGODB_DB_NAME="smarttraffic"

# External APIs
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
TOMTOM_API_KEY="your-tomtom-traffic-api-key"
HERE_API_KEY="your-here-traffic-api-key"

